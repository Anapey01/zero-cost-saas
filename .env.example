# ── Backend ──────────────────────────────────────────────────────────────
# Postgres connection string from your serverless DB provider
DATABASE_URL=postgresql://user:password@host/dbname

# Django secret key — generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-long-random-secret-key-here

# Shared secret for the cron webhook endpoint
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# Google AI Studio API key (free tier: gemini.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# ── Frontend ─────────────────────────────────────────────────────────────
# Cloudinary cloud name (find in your Cloudinary dashboard)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Backend API base URL
NEXT_PUBLIC_API_URL=https://api.example.com
